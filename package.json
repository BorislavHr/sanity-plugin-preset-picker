{
  "name": "sanity-plugin-preset-picker",
  "version": "0.1.0",
  "description": "A Sanity Studio field that lets editors pick a value from visual tiles (backgrounds, themes, layouts) instead of a dropdown.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "input",
    "picker",
    "preset",
    "background",
    "theme",
    "visual"
  ],
  "license": "MIT",
  "author": "Borislav Hristov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BorislavHr/sanity-plugin-preset-picker.git"
  },
  "homepage": "https://github.com/BorislavHr/sanity-plugin-preset-picker#readme",
  "bugs": {
    "url": "https://github.com/BorislavHr/sanity-plugin-preset-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "default": "./dist/patterns.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground": "vite examples/playground",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@sanity/ui": "^4",
    "react": "^19.2",
    "sanity": "^6"
  },
  "devDependencies": {
    "@sanity/ui": "^4.4.12",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.24.0",
    "styled-components": "^6.6.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
